{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlockBook",
  "version": "0.3.0",
  "identifier": "com.blockbook.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BlockBook",
        "width": 900,
        "height": 640,
        "minWidth": 560,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Minecraft coordinate book and portal validator",
    "longDescription": "Local-first companion for a Java Edition survival world: searchable coordinate book, nether portal link validator, and offline brewing tables."
  }
}
